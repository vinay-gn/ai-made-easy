# AI Made Easy backend settings. Copy to .env and adjust as needed
APP_HOST=127.0.0.1
APP_PORT=8001
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Roadmap data file (relative to backend/ or absolute)
DATA_FILE=app/data/roadmap.v2.json
# Comma-separated tracks exposed by the API (use, build). Hidden tracks stay in the data file.
ENABLED_TRACKS=use
